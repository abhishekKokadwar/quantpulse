# Neon / PostgreSQL Connection URL
DATABASE_URL=postgresql://<username>:<password>@<host>/neondb?sslmode=require

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=gridpulse.telemetry.raw
KAFKA_GROUP_ID=gridpulse-consumer-group

# Telegram Bot Incident Alerting (Primary / Preferred)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# Legacy External Incident Webhook (Slack, Discord, or Webhook.site)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# S3 / MinIO Cloud Object Storage Configuration (Phase 10)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=gridpulse_admin
S3_SECRET_KEY=gridpulse_password
S3_BUCKET_NAME=gridpulse-lakehouse
S3_REGION=us-east-1
